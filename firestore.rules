rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep this email in sync with ADMIN_EMAILS in src/lib/constants.ts.
    // Auth stores the address in lowercase.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == "26m0311@iitb.ac.in";
    }

    function emailMatches() {
      return request.auth.token.email is string
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower();
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    // Missing fields must be tested with keys() first. Reading an absent field errors.
    function hasStoredName(data) {
      return data.keys().hasAny(["name"]) && data.name is string && data.name.size() > 0;
    }

    function hasStoredRole(data) {
      return data.keys().hasAny(["role"]) && data.role is string;
    }

    // A profile with no role field is an existing APC account.
    function isPlacement() {
      return signedIn()
        && exists(userPath())
        && hasStoredRole(userData())
        && userData().role == "placement";
    }

    function isApc() {
      return signedIn()
        && exists(userPath())
        && !(hasStoredRole(userData()) && userData().role == "placement")
        && (
          (hasStoredRole(userData()) && userData().role == "apc")
          || hasStoredName(userData())
        );
    }

    function hasName() {
      return signedIn() && exists(userPath()) && hasStoredName(userData());
    }

    function userName() {
      return userData().name;
    }

    function apcNames() {
      return [
        "Abhay", "Chirantan", "Priyesh", "Jeet", "Mihir", "Sadarul", "Siddhant",
        "Pratik", "Rutuja", "Tanay", "Varun", "Vishwas", "Subhalakshmi", "Bhavya",
        "Manali", "Medini", "Sandeep", "Punarvas", "Sarthak", "Vityashri", "Yogeshwar"
      ];
    }

    function placementNames() {
      return ["Laxami", "Priyanka", "Aryan", "Ishika", "Chinmay"];
    }

    function isApcName(name) {
      return name in apcNames();
    }

    function isPlacementName(name) {
      return name in placementNames();
    }

    // get() sees the database before this transaction. getAfter() sees the
    // other documents written in the same transaction, which is required when
    // a name claim or an order and its member pointer are saved together.
    function claimAfter(name) {
      return getAfter(/databases/$(database)/documents/claims/$(name));
    }

    function placementClaimAfter(name) {
      return getAfter(/databases/$(database)/documents/placementClaims/$(name));
    }

    function orderPath(date, id) {
      return /databases/$(database)/documents/days/$(date)/orders/$(id);
    }

    function memberPath(date, name) {
      return /databases/$(database)/documents/days/$(date)/members/$(name);
    }

    function placementOrderPath(date, id) {
      return /databases/$(database)/documents/placementDays/$(date)/orders/$(id);
    }

    function placementMemberPath(date, name) {
      return /databases/$(database)/documents/placementDays/$(date)/members/$(name);
    }

    function validOrder(data) {
      return data.keys().hasAll(["members", "items", "extras", "note", "placed", "placedAt"])
        && data.members is list
        && data.members.size() > 0
        && data.items is map
        && data.extras is map
        && data.note is string
        && data.placed is bool
        && (data.placedAt == null || data.placedAt is number);
    }

    function apcOrder(data) {
      return validOrder(data) && data.members.hasOnly(apcNames());
    }

    function placementOrder(data) {
      return validOrder(data) && data.members.hasOnly(placementNames());
    }

    function sameMembers() {
      return request.resource.data.members.hasAny([userName()])
        && request.resource.data.members.hasAll(resource.data.members)
        && resource.data.members.hasAll(request.resource.data.members);
    }

    // A member may remove only themselves, and must leave the dishes untouched.
    function leavingSelf() {
      return resource.data.members.hasAny([userName()])
        && !(request.resource.data.members.hasAny([userName()]))
        && request.resource.data.members.hasAll(resource.data.members.removeAll([userName()]))
        && resource.data.members.removeAll([userName()]).hasAll(request.resource.data.members)
        && request.resource.data.items == resource.data.items
        && request.resource.data.extras == resource.data.extras
        && request.resource.data.note == resource.data.note;
    }

    // Deleting someone else's solo order is allowed only when their member
    // pointer now sits on an order that includes the writer and every old member.
    function movedWithMe(date) {
      return resource.data.members.size() > 0
        && existsAfter(memberPath(date, resource.data.members[0]))
        && existsAfter(orderPath(date, getAfter(memberPath(date, resource.data.members[0])).data.orderId))
        && getAfter(orderPath(date, getAfter(memberPath(date, resource.data.members[0])).data.orderId)).data.members.hasAny([userName()])
        && getAfter(orderPath(date, getAfter(memberPath(date, resource.data.members[0])).data.orderId)).data.members.hasAll(resource.data.members);
    }

    function movedWithPlacement(date) {
      return resource.data.members.size() > 0
        && existsAfter(placementMemberPath(date, resource.data.members[0]))
        && existsAfter(placementOrderPath(date, getAfter(placementMemberPath(date, resource.data.members[0])).data.orderId))
        && getAfter(placementOrderPath(date, getAfter(placementMemberPath(date, resource.data.members[0])).data.orderId)).data.members.hasAny([userName()])
        && getAfter(placementOrderPath(date, getAfter(placementMemberPath(date, resource.data.members[0])).data.orderId)).data.members.hasAll(resource.data.members);
    }

    function userShape() {
      return request.resource.data.keys().hasOnly(["email", "name", "role"]);
    }

    function requestedPlacement() {
      return hasStoredRole(request.resource.data) && request.resource.data.role == "placement";
    }

    function choosingSide() {
      return !request.resource.data.keys().hasAny(["name"])
        && hasStoredRole(request.resource.data)
        && (request.resource.data.role == "apc" || request.resource.data.role == "placement");
    }

    function claimingName() {
      return hasStoredName(request.resource.data)
        && (
          (
            requestedPlacement()
            && isPlacementName(request.resource.data.name)
            && placementClaimAfter(request.resource.data.name).data.uid == request.auth.uid
          )
          || (
            !requestedPlacement()
            && isApcName(request.resource.data.name)
            && claimAfter(request.resource.data.name).data.uid == request.auth.uid
          )
        );
    }

    function sideAlreadyChosen() {
      return hasStoredRole(resource.data)
        && (resource.data.role == "apc" || resource.data.role == "placement");
    }

    function roleStays() {
      return !sideAlreadyChosen() || resource.data.role == request.resource.data.role;
    }

    function sameRoleFields() {
      return (
        hasStoredRole(resource.data)
        && hasStoredRole(request.resource.data)
        && request.resource.data.role == resource.data.role
      ) || (
        !hasStoredRole(resource.data) && !hasStoredRole(request.resource.data)
      );
    }

    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && emailMatches()
        && userShape()
        && (choosingSide() || claimingName());
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && emailMatches()
          && userShape()
          && (
            (
              hasStoredName(resource.data)
              && hasStoredName(request.resource.data)
              && resource.data.name == request.resource.data.name
              && sameRoleFields()
            )
            || (
              !hasStoredName(resource.data)
              && claimingName()
              && roleStays()
            )
            || (
              !hasStoredName(resource.data)
              && !sideAlreadyChosen()
              && choosingSide()
            )
          ));
      allow delete: if isAdmin();
    }

    match /claims/{name} {
      allow read: if isAdmin() || isApc();
      allow create: if signedIn()
        && isApcName(name)
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath()).data.name == name
        && !(getAfter(userPath()).data.keys().hasAny(["role"]) && getAfter(userPath()).data.role == "placement");
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /placementClaims/{name} {
      allow read: if isAdmin() || isPlacement();
      allow create: if signedIn()
        && isPlacementName(name)
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath()).data.name == name
        && getAfter(userPath()).data.keys().hasAny(["role"])
        && getAfter(userPath()).data.role == "placement";
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /budgets/{date} {
      allow read: if isAdmin() || isApc();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["amount"])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    match /placementBudgets/{date} {
      allow read: if isAdmin() || isPlacement();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["amount"])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    match /days/{date}/members/{name} {
      allow read: if isAdmin() || isApc();
      allow create, update: if isApc()
        && hasName()
        && isApcName(name)
        && request.resource.data.keys().hasOnly(["orderId"])
        && request.resource.data.orderId is string
        && existsAfter(orderPath(date, request.resource.data.orderId))
        && getAfter(orderPath(date, request.resource.data.orderId)).data.members.hasAny([userName()])
        && getAfter(orderPath(date, request.resource.data.orderId)).data.members.hasAny([name]);
      allow delete: if isAdmin();
    }

    match /days/{date}/orders/{orderId} {
      allow read: if isAdmin() || isApc();
      allow create: if isApc()
        && hasName()
        && apcOrder(request.resource.data)
        && request.resource.data.members.hasAny([userName()]);
      allow update: if isApc()
        && hasName()
        && apcOrder(request.resource.data)
        && (sameMembers() || leavingSelf());
      allow delete: if isApc()
        && hasName()
        && (resource.data.members.hasAny([userName()]) || movedWithMe(date));
    }

    match /placementDays/{date}/members/{name} {
      allow read: if isAdmin() || isPlacement();
      allow create, update: if isPlacement()
        && hasName()
        && isPlacementName(name)
        && request.resource.data.keys().hasOnly(["orderId"])
        && request.resource.data.orderId is string
        && existsAfter(placementOrderPath(date, request.resource.data.orderId))
        && getAfter(placementOrderPath(date, request.resource.data.orderId)).data.members.hasAny([userName()])
        && getAfter(placementOrderPath(date, request.resource.data.orderId)).data.members.hasAny([name]);
      allow delete: if isAdmin();
    }

    match /placementDays/{date}/orders/{orderId} {
      allow read: if isAdmin() || isPlacement();
      allow create: if isPlacement()
        && hasName()
        && placementOrder(request.resource.data)
        && request.resource.data.members.hasAny([userName()]);
      allow update: if isPlacement()
        && hasName()
        && placementOrder(request.resource.data)
        && (sameMembers() || leavingSelf());
      allow delete: if isPlacement()
        && hasName()
        && (resource.data.members.hasAny([userName()]) || movedWithPlacement(date));
    }
  }
}
